{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "const": 1
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "multica": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string",
          "pattern": "^https?://"
        },
        "controllerTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "key"
          ]
        }
      },
      "required": [
        "baseURL",
        "controllerTokenSecret"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "heartbeatInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      },
      "required": [
        "name",
        "image",
        "capacity",
        "pollInterval",
        "heartbeatInterval"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "platform": {
          "type": "string",
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pi",
              "codex",
              "copilot",
              "antigravity"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "bundled",
                "inline",
                "configMap"
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "script": {
              "type": "string"
            },
            "configMap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "key",
                "sha256"
              ]
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "secretEnvFrom": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/secretEnvFrom"
              }
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "$ref": "#/$defs/resources"
            }
          },
          "required": [
            "source",
            "revision",
            "script",
            "configMap",
            "env",
            "secretEnvFrom",
            "timeout",
            "resources"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "bundled"
                  }
                }
              },
              "then": {
                "properties": {
                  "script": {
                    "const": ""
                  },
                  "configMap": {
                    "properties": {
                      "name": {
                        "const": ""
                      },
                      "key": {
                        "const": ""
                      },
                      "sha256": {
                        "const": ""
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "inline"
                  }
                }
              },
              "then": {
                "properties": {
                  "script": {
                    "minLength": 1
                  },
                  "configMap": {
                    "properties": {
                      "name": {
                        "const": ""
                      },
                      "key": {
                        "const": ""
                      },
                      "sha256": {
                        "const": ""
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "configMap"
                  }
                }
              },
              "then": {
                "properties": {
                  "script": {
                    "const": ""
                  },
                  "configMap": {
                    "properties": {
                      "name": {
                        "minLength": 1
                      },
                      "key": {
                        "minLength": 1
                      },
                      "sha256": {
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "storage": {
          "$ref": "#/$defs/storage"
        }
      },
      "required": [
        "image",
        "platform",
        "providers",
        "bootstrap",
        "storage"
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "$ref": "#/$defs/storage"
        }
      },
      "required": [
        "storage"
      ]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envFrom"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        },
        "configVolumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configVolume"
          }
        },
        "configMounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configMount"
          }
        }
      },
      "required": [
        "envFrom",
        "env",
        "configVolumes",
        "configMounts"
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "resources",
        "podAnnotations"
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "taskDeadline": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGraceSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "resources",
        "taskDeadline",
        "terminationGraceSeconds"
      ]
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "singleNodeName": {
          "type": "string"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": []
          }
        }
      },
      "required": [
        "nodeSelector",
        "singleNodeName",
        "tolerations"
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "enabled",
        "maxUnavailable"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "replicaCount",
    "imagePullSecrets",
    "multica",
    "runtime",
    "environment",
    "workspace",
    "operator",
    "controller",
    "worker",
    "scheduling",
    "podDisruptionBudget",
    "networkPolicy"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "reference",
        "pullPolicy"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/quantities"
        },
        "limits": {
          "$ref": "#/$defs/quantities"
        }
      },
      "required": []
    },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "envFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        },
        "configMapRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [],
      "oneOf": [
        {
          "required": [
            "secretRef"
          ]
        },
        {
          "required": [
            "configMapRef"
          ]
        }
      ]
    },
    "secretEnvFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "secretRef"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      },
      "required": [
        "existingClaim",
        "size",
        "storageClass",
        "accessMode"
      ],
      "oneOf": [
        {
          "properties": {
            "existingClaim": {
              "minLength": 1
            },
            "size": {
              "const": ""
            },
            "storageClass": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "existingClaim": {
              "const": ""
            },
            "size": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            },
            "configMapKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            }
          },
          "required": [],
          "oneOf": [
            {
              "required": [
                "secretKeyRef"
              ]
            },
            {
              "required": [
                "configMapKeyRef"
              ]
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "valueFrom"
          ]
        }
      ]
    },
    "configVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            },
            "defaultMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^/].*"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                },
                "required": [
                  "key",
                  "path"
                ]
              }
            }
          },
          "required": [
            "secretName"
          ]
        },
        "configMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            },
            "defaultMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^/].*"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                },
                "required": [
                  "key",
                  "path"
                ]
              }
            }
          },
          "required": [
            "name"
          ]
        },
        "projected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "secret": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "optional": {
                        "type": "boolean"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[^/].*"
                            },
                            "mode": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 511
                            }
                          },
                          "required": [
                            "key",
                            "path"
                          ]
                        }
                      }
                    },
                    "required": [
                      "name"
                    ]
                  },
                  "configMap": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "optional": {
                        "type": "boolean"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[^/].*"
                            },
                            "mode": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 511
                            }
                          },
                          "required": [
                            "key",
                            "path"
                          ]
                        }
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "required": [],
                "oneOf": [
                  {
                    "required": [
                      "secret"
                    ]
                  },
                  {
                    "required": [
                      "configMap"
                    ]
                  }
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "sources"
          ]
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "secret"
          ]
        },
        {
          "required": [
            "configMap"
          ]
        },
        {
          "required": [
            "projected"
          ]
        }
      ]
    },
    "configMount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/home/multica/agents/[^/].*",
          "description": "Canonical file or directory destination beneath /home/multica/agents. Runtime daemon state, assigned Codex skills and Pi sessions are protected, including within copied directories."
        },
        "subPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*",
          "description": "Optional source file or directory within the selected configVolume."
        },
        "readOnly": {
          "const": true,
          "description": "The input volume is always read-only and mounted only in layout init. The destination copy is writable by the runtime user."
        }
      },
      "required": [
        "name",
        "mountPath",
        "readOnly"
      ],
      "description": "Copy one read-only operator input into private writable native HOME during layout initialization. Existing files are preserved; a new Pod receives fresh input copies."
    }
  }
}
