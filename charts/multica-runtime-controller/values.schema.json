{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "multica": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string",
          "pattern": "^https?://"
        },
        "controllerTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "key"
          ]
        }
      },
      "required": [
        "baseURL",
        "controllerTokenSecret"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "heartbeatInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "startupTimeout": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$",
          "description": "Positive startup deadline; the startup probe permits this deadline plus initialization margin."
        }
      },
      "required": [
        "name",
        "capacity",
        "pollInterval",
        "heartbeatInterval",
        "startupTimeout"
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "$ref": "#/$defs/storage"
        }
      },
      "required": [
        "storage"
      ]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envFrom"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        },
        "configVolumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configVolume"
          }
        },
        "configMounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configMount"
          }
        }
      },
      "required": [
        "envFrom",
        "env",
        "configVolumes",
        "configMounts"
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "resources",
        "podAnnotations"
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "taskDeadline": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGraceSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "resources",
        "taskDeadline",
        "terminationGraceSeconds"
      ]
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "singleNodeName": {
          "type": "string"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": []
          }
        }
      },
      "required": [
        "nodeSelector",
        "singleNodeName",
        "tolerations"
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "enabled",
        "maxUnavailable"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "blockKubernetesAPI": {
          "type": "boolean"
        },
        "blockedEgressCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$|^[0-9A-Fa-f:]*:[0-9A-Fa-f:]*/(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
          },
          "description": "Additional canonical network CIDRs excluded from every worker egress allow rule on all ports, independently of blockKubernetesAPI. Use 0.0.0.0/0 or ::/0 for an entire address family. Kubernetes validates the CIDR network address and prefix."
        }
      },
      "required": [
        "enabled",
        "blockKubernetesAPI",
        "blockedEgressCIDRs"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)*|\\[[a-fA-F0-9:]+\\])(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?(?:@sha256:[a-f0-9]{64})?$",
      "description": "Complete custom runtime image, using a tag, digest, or both. Legacy runtime.image and environment settings are unsupported."
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ]
    }
  },
  "required": [
    "imagePullSecrets",
    "multica",
    "runtime",
    "workspace",
    "operator",
    "controller",
    "worker",
    "scheduling",
    "podDisruptionBudget",
    "networkPolicy",
    "image",
    "imagePullPolicy",
    "platform"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/quantities"
        },
        "limits": {
          "$ref": "#/$defs/quantities"
        }
      },
      "required": []
    },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "envFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        },
        "configMapRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [],
      "oneOf": [
        {
          "required": [
            "secretRef"
          ]
        },
        {
          "required": [
            "configMapRef"
          ]
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      },
      "required": [
        "existingClaim",
        "size",
        "storageClass",
        "accessMode"
      ],
      "oneOf": [
        {
          "properties": {
            "existingClaim": {
              "minLength": 1
            },
            "size": {
              "const": ""
            },
            "storageClass": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "existingClaim": {
              "const": ""
            },
            "size": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            },
            "configMapKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            }
          },
          "required": [],
          "oneOf": [
            {
              "required": [
                "secretKeyRef"
              ]
            },
            {
              "required": [
                "configMapKeyRef"
              ]
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "valueFrom"
          ]
        }
      ]
    },
    "configVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "configMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "const": false
            },
            "defaultMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^/].*"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                },
                "required": [
                  "key",
                  "path"
                ]
              }
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "name",
        "configMap"
      ]
    },
    "configMount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/home/multica/agents/[^/].*",
          "description": "Canonical file or directory destination beneath /home/multica/agents, including operator Codex skills. Runtime daemon state and Pi sessions are protected, including within copied directories."
        },
        "subPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*",
          "description": "Optional source file or directory within the selected configVolume."
        },
        "readOnly": {
          "const": true,
          "description": "The input volume is always read-only and mounted only in layout init. The destination copy is writable by the runtime user."
        }
      },
      "required": [
        "name",
        "mountPath",
        "readOnly"
      ],
      "description": "Copy one read-only operator input into private writable native HOME during layout initialization. Existing files are preserved; a new Pod receives fresh input copies."
    }
  }
}
